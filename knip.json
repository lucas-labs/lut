{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["src/components/ui/**", "src/components/ai-elements/**"],
  "ignoreDependencies": [
    "@tauri-apps/plugin-log",
    "@tauri-apps/plugin-window-state",
    "@fontsource-variable/inter",
    "@fontsource/jetbrains-mono",
    "@smoke-driver"
  ],
  "ignoreBinaries": ["footprint", "swiftc", "where"],
  "ignoreIssues": {
    "src/bench/flags.ts": ["exports"],
    "packages/ghostty-core/lib/official/types.ts": ["enumMembers"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "src/settings/main.tsx",
        "src/modules/agents/model/index.ts",
        "src/modules/control/agents.ts",
        "src/modules/statusbar/OsIcon.tsx",
        "src/modules/statusbar/useGitBranch.ts",
        "src/modules/statusbar/useSystemInfo.ts",
        "src/**/*.test.{ts,tsx}",
        "src/**/*.bench.ts",
        "scripts/**/*.html",
        "scripts/**/*.{ts,mjs}"
      ],
      "project": ["src/**/*.{ts,tsx,css}"]
    }
  }
}
