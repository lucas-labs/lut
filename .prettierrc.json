{
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "printWidth": 100,
  "endOfLine": "lf",
  "overrides": [
    { "files": "*.tsx", "options": { "printWidth": 120 } },
    { "files": "*.md", "options": { "printWidth": 120, "proseWrap": "preserve", "embeddedLanguageFormatting": "off" } }
  ]
}
